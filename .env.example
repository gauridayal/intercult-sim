# OpenAI-compatible chat completions endpoint (real OpenAI, or any
# self-hosted compatible server -- vLLM, Ollama, LM Studio, etc.)
OPENAI_API_KEY=not-required
OPENAI_API_BASE_URL=http://your-local-server:port/v1
OPENAI_MODEL=your-model-name

# Where the post-conversation analysis record gets persisted once a scene
# ends. Points at a Google Apps Script Web App deployed on top of a Google
# Sheet -- see "Post-conversation analysis" in README.md for setup. Leave
# unset to skip remote persistence (local runs still always write a
# numbered JSON file under ANALYSIS_LOG_DIR; this is the only option on
# Vercel, which has no persistent disk).
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Local-only: directory the local JSON analysis files are written to.
ANALYSIS_LOG_DIR=analysis_logs
